{
  "name": "js-ts-quality-checker-kit",
  "version": "1.0.0",
  "description": "Initialize JavaScript and TypeScript quality tools in an existing project with npx.",
  "license": "MIT",
  "author": "Alexey Sedoykin <sedoykin@gmail.com> (https://github.com/Krusty84/js-ts-quality-checker-kit)",
  "keywords": [
    "biome",
    "semgrep",
    "knip",
    "spdx",
    "lefthook",
    "codex",
    "quality",
    "javascript",
    "typescript",
    "checker"
  ],
  "main": "./main.js",
  "type": "module",
  "bin": {
    "js-ts-quality-checker-kit": "./main.js"
  },
  "files": [
    "main.js",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/cli.test.js test/license-header.test.js",
    "test:smoke": "node --test test/smoke.js",
    "test:semgrep": "node --test scripts/semgrep-smoke.js"
  }
}
