{
  "name": "js-ts-quality-checker-kit",
  "version": "1.0.0",
  "description": "The package for (manual and AI-based) quality checking of JS and TS code using Biome, Semgrep, Knip, etc.",
  "license": "MIT",
  "author": "Alexey Sedoykin <sedoykin@gmail.com> (https://github.com/Krusty84/js-ts-quality-checker-kit)",
  "keywords": [
    "quality",
    "javascript",
    "typescript",
    "checker",
    "biome",
    "semgrep",
    "knip",
    "agent",
    "claude",
    "codex"
  ],
  "main": "./main.js",
  "type": "module",
  "bin": {
    "js-ts-quality-checker-kit": "./main.js"
  },
  "files": [
    "main.js",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "scripts": {
    "test": "node --test test/cli.test.js test/license-header.test.js",
    "test:smoke": "node --test test/smoke.js",
    "test:semgrep": "node --test test/semgrep-smoke.js"
  }
}
